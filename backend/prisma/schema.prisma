generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  nomeCompleto String
  email        String  @unique
  senhaHash    String
  dataCadastro String?
}

model Assinatura {
  id         Int     @id @default(autoincrement())
  idUsuario  Int
  idPlano    Int
  dataInicio String?
  dataFim    String?
}

model Aula {
  id             Int    @id @default(autoincrement())
  idModulo       Int
  titulo         String
  tipoConteudo   String
  urlConteudo    String
  duracaoMinutos Int
  ordem          Int
}

model Avaliacao {
  id            Int     @id @default(autoincrement())
  idUsuario     Int
  idCurso       Int
  nota          Int
  comentario    String?
  dataAvaliacao String?
}

model Categoria {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String
}

model Certificado {
  id                Int     @id @default(autoincrement())
  idUsuario         Int
  idCurso           Int
  idTrilha          Int?
  codigoVerificacao String
  dataEmissao       String?
}

model Curso {
  id             Int     @id @default(autoincrement())
  titulo         String
  descricao      String
  idInstrutor    Int
  idCategoria    Int
  nivel          String
  dataPublicacao String?
  totalAulas     Int
  totalHoras     Int
}

model Matricula {
  id            Int     @id @default(autoincrement())
  idUsuario     Int
  idCurso       Int
  dataMatricula String?
  dataConclusao String?
}

model Modulo {
  id      Int    @id @default(autoincrement())
  idCurso Int
  titulo  String
  ordem   Int
}

model Pagamento {
  id                 Int     @id @default(autoincrement())
  idAssinatura       Int
  valorPago          Float
  dataPagamento      String?
  metodoPagamento    String
  idTransacaoGateway String
}

model Plano {
  id           Int    @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Float
  duracaoMeses Int
}

model ProgressoAula {
  id            Int    @id @default(autoincrement())
  idUsuario     Int
  idAula        Int
  dataConclusao String
  status        String
}

model Trilha {
  id          Int    @id @default(autoincrement())
  titulo      String
  descricao   String
  idCategoria Int
}

model TrilhaCurso {
  id       Int @id @default(autoincrement())
  idTrilha Int
  idCurso  Int
  ordem    Int
}
